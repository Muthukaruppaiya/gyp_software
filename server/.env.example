PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gym_management
DB_USER=postgres
DB_PASSWORD=postgres

# REQUIRED in production (NODE_ENV=production refuses to start without it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If left empty in development, a random secret is used and sessions reset on every restart.
JWT_SECRET=

CLIENT_URL=http://localhost:5173

# The gym's local timezone: decides "today", midnight auto check-out, and every DATE value.
GYM_TIMEZONE=Asia/Kolkata

# Set to 1 when running behind a reverse proxy so login rate limits see the real client IP.
# TRUST_PROXY=1

# NODE_ENV=production
